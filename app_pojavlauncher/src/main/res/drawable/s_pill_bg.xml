<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="@color/s_card_pressed" />
            <stroke android:width="2dp" android:color="@color/s_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <gradient android:angle="270" android:startColor="#1E1E1E" android:endColor="#0B0B0B" />
            <stroke android:width="1.5dp" android:color="#CCFFC400" />
        </shape>
    </item>
</selector>
